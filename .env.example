# ===== 服务 =====
DATA_DIR=./data
HOST=0.0.0.0
PORT=8618
MC_VERSION=latest
# Mojang 镜像（国内服务器可选），如 https://bmclapi2.bangbang93.com
# 设置后版本清单、版本 json、client jar 全部走镜像
MC_MIRROR_URL=
SOURCES=wiki,jar
ICON_SIZE=96
CHECK_INTERVAL=21600
UPDATE_ON_START=true
CONCURRENCY=4
REFRESH_TOKEN=
# 日志级别：DEBUG 会额外打印 /healthz、/readyz 探针和 wiki 请求细节
LOG_LEVEL=INFO

# ===== 图床上传（CloudFlare ImgBed POST /upload）=====
# 图床站点地址，不带结尾斜杠
UPLOAD_BASE_URL=https://cfbed.sanyue.de
# 上传端点路径
UPLOAD_PATH=/upload
# 上传认证码（Query 参数 authCode），与 UPLOAD_TOKEN 二选一或都填
UPLOAD_AUTH_CODE=
# API Token（Header: Authorization: Bearer），需具备 upload 权限
UPLOAD_TOKEN=
# 上传渠道：telegram / cfr2 / s3 / discord / huggingface / webdav
UPLOAD_CHANNEL=s3
# 多渠道场景下指定渠道名称，留空用默认渠道（可用 /api/channels 查询）
UPLOAD_CHANNEL_NAME=CloudFlare_R2
# 上传目录（Query 参数 uploadFolder），插件按 /file/mc_admin/<文件名> 取图
UPLOAD_FOLDER=/mc_admin/task_icon
# 命名方式：default(前缀_原名) / index(仅前缀) / origin(仅原名) / short(短链)
# 必须是 origin，否则文件名会被改写，插件拼出来的 URL 就对不上
UPLOAD_NAME_TYPE=origin
# 返回格式：default(/file/id) / full(完整链接)
UPLOAD_RETURN_FORMAT=default
# 服务端压缩（仅 Telegram 渠道图片），关掉以免动到 PNG/GIF
UPLOAD_SERVER_COMPRESS=false
# 失败自动切换渠道重试
UPLOAD_AUTO_RETRY=false

# ===== 上传行为 =====
# 并发上传数
UPLOAD_CONCURRENCY=2
# 单次请求超时（秒）
UPLOAD_TIMEOUT=60
# 已存在的文件跳过（用 HEAD 探测 UPLOAD_PUBLIC_BASE + 目录 + 文件名）
UPLOAD_SKIP_EXISTING=true
# 公开访问前缀，用于存在性探测，例：https://cfbed.sanyue.de/file
UPLOAD_PUBLIC_BASE=
# 构建完成后自动上传
UPLOAD_AFTER_BUILD=false
# 额外 Query 参数，逗号分隔的 k=v，用于图床以后新增的参数
UPLOAD_EXTRA_PARAMS=
